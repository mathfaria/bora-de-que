# Copie para .env e preencha. Nunca faça commit do .env.

# Postgres com pgvector (Neon: Connect > connection string com ?sslmode=require; `neon init` preenche sozinho)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Provedor de LLM do agente: gemini | none (none = modo simples, sem LLM)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Extrator de filtros usado pela busca: rules (padrão, instantâneo) | llm | finetuned (experimental)
EXTRACTOR=rules
# Modelo ajustado (pasta local ou id no Hugging Face)
FINETUNED_MODEL=models/bocado-extrator

# Link do repositório: aparece no User-Agent enviado ao Nominatim (a política de uso pede contato)
REPO_URL=

# Limites da demo pública
RATE_LIMIT_PER_IP=20
RATE_LIMIT_WINDOW_S=600
